+/* NAPI delivery of RX frames and TX statuses (htphy_napi=1).
+ *
+ * Without it, the IRQ thread hands every received frame to mac80211
+ * outside of NAPI, so received TCP segments never go through GRO.
+ * Instead, the IRQ thread queues RX frames and TX statuses, in hardware
+ * completion order, on one FIFO, and a NAPI poll function on a dummy
+ * netdev hands them to mac80211. All hardware access stays in the IRQ thread under
+ * wl->mutex. The poll function owns only finished skbs and never takes
+ * wl->mutex.
+ *
+ * As mac80211 does for its own frame queue (see
+ * ieee80211_handle_queued_frames()), skb->pkt_type tags the type of the
+ * queued skb. It is reset to 0 before mac80211 sees the skb.
+ */
+#define B43_NAPI_RX		PACKET_HOST
+#define B43_NAPI_TX		PACKET_OUTGOING
+/* Received frames are dropped once this many skbs are queued in total. */
+#define B43_NAPI_RX_LIMIT	4096
+/* TX statuses are never dropped: mac80211 needs them for rate control,
+ * for TX status reporting and to free the frames. Instead, TX submission
+ * is paused at B43_NAPI_TX_HIGH queued statuses and resumed at
+ * B43_NAPI_TX_LOW. While paused, at most the frames already on the BE and
+ * the multicast DMA rings, 2 * B43_TXRING_SLOTS / TX_SLOTS_PER_FRAME = 256,
+ * can add statuses.
+ */
+#define B43_NAPI_TX_HIGH	2048
+#define B43_NAPI_TX_LOW		512
+/* See b43_wireless_init() */
+#define B43_NAPI_GRO_FLUSH_TIMEOUT_NS	125000
+
+static bool b43_napi_eligible(struct b43_bus_dev *dev)
+{
+#if defined(CONFIG_B43_BCMA) && defined(CONFIG_BCMA_HOST_PCI)
+	return modparam_htphy_napi && modparam_htphy_11n >= 2 &&
+		!modparam_qos4331 &&
+		dev->bus_type == B43_BUS_BCMA &&
+		dev->chip_id == BCMA_CHIP_ID_BCM4331 &&
+		dev->bdev->bus->hosttype == BCMA_HOSTTYPE_PCI &&
+		dev->bdev->bus->host_pci &&
+		pci_is_pcie(dev->bdev->bus->host_pci);
+#else
+	return false;
+#endif
+}
+
+static int b43_napi_poll(struct napi_struct *napi, int budget)
+{
+	struct b43_wl *wl = container_of(napi, struct b43_wl, napi);
+	struct sk_buff *skb;
+	int work = 0;
+
+	/* Deliver in queue order. TX statuses count against the budget
+	 * like RX frames.
+	 */
+	while (work < budget && (skb = skb_dequeue(&wl->napi_queue))) {
+		bool tx = skb->pkt_type == B43_NAPI_TX;
+
+		skb->pkt_type = 0;
+		if (tx) {
+			/* Let b43_tx_work() lift the TX pause. This may
+			 * run before the IRQ thread has set the pause, but
+			 * that holds wl->mutex until it has, and the work
+			 * checks the count again under wl->mutex.
+			 */
+			if (atomic_dec_return(&wl->napi_tx_queued) ==
+			    B43_NAPI_TX_LOW)
+				ieee80211_queue_work(wl->hw, &wl->tx_work);
+			ieee80211_tx_status_skb(wl->hw, skb);
+		} else {
+			ieee80211_rx_napi(wl->hw, NULL, skb, napi);
+		}
+		work++;
+	}
+
+	if (work < budget && napi_complete_done(napi, work)) {
+		/* The IRQ thread schedules NAPI after queueing, but that
+		 * is a no-op while this poll still owns NAPI. Recheck the
+		 * queue after completing to not miss such a frame.
+		 * b43_napi_stop() waits for this with synchronize_net().
+		 */
+		smp_mb();
+		if (!skb_queue_empty_lockless(&wl->napi_queue))
+			napi_schedule(napi);
+	}
+	return work;
+}
+
+static void b43_napi_enqueue(struct b43_wl *wl, struct sk_buff *skb,
+			     unsigned char type)
+{
+	unsigned long flags;
+	bool drop;
+	int tx_count = 0;
+
+	lockdep_assert_held(&wl->mutex);
+	skb->pkt_type = type;
+	spin_lock_irqsave(&wl->napi_queue.lock, flags);
+	drop = type == B43_NAPI_RX &&
+		skb_queue_len(&wl->napi_queue) >= B43_NAPI_RX_LIMIT;
+	if (!drop) {
+		if (type == B43_NAPI_TX)
+			tx_count = atomic_inc_return(&wl->napi_tx_queued);
+		__skb_queue_tail(&wl->napi_queue, skb);
+	}
+	spin_unlock_irqrestore(&wl->napi_queue.lock, flags);
+
+	if (drop) {
+		wl->napi_rx_drops++;
+		dev_kfree_skb_any(skb);
+		return;
+	}
+	if (tx_count >= B43_NAPI_TX_HIGH && !wl->napi_tx_blocked) {
+		/* Every submission path runs under wl->mutex and checks
+		 * napi_tx_blocked, so none can be halfway through.
+		 */
+		WRITE_ONCE(wl->napi_tx_blocked, true);
+		wl->napi_tx_pauses++;
+		ieee80211_stop_queues(wl->hw);
+	}
+	napi_schedule(&wl->napi);
+}
+
+void b43_rx_handoff(struct b43_wldev *dev, struct sk_buff *skb)
+{
+	struct b43_wl *wl = dev->wl;
+
+	lockdep_assert_held(&wl->mutex);
+	if (wl->napi_enabled)
+		b43_napi_enqueue(wl, skb, B43_NAPI_RX);
+	else
+		ieee80211_rx_ni(wl->hw, skb);
+}
+
+void b43_tx_status_handoff(struct b43_wldev *dev, struct sk_buff *skb)
+{
+	struct b43_wl *wl = dev->wl;
+
+	lockdep_assert_held(&wl->mutex);
+	if (wl->napi_enabled)
+		b43_napi_enqueue(wl, skb, B43_NAPI_TX);
+	else
+		ieee80211_tx_status_skb(wl->hw, skb);
+}
+
+/* Called after the core is initialized, so the transfer mode is known,
+ * and before the IRQ is requested.
+ */
+static void b43_napi_start(struct b43_wldev *dev)
+{
+	struct b43_wl *wl = dev->wl;
+
+	/* Lock order is wl->mutex, then napi_mutex. */
+	lockdep_assert_held(&wl->mutex);
+	mutex_lock(&wl->napi_mutex);
+	if (wl->napi_dev && dev->phy.type == B43_PHYTYPE_HT &&
+	    wl->shared_tx_queue && !b43_using_pio_transfers(dev) &&
+	    !wl->napi_enabled) {
+		atomic_set(&wl->napi_tx_queued, 0);
+		WRITE_ONCE(wl->napi_tx_blocked, false);
+		napi_enable(&wl->napi);
+		wl->napi_enabled = true;
+		b43dbg(wl, "NAPI enabled (%llu RX drops, %llu TX pauses so far)\n",
+		       wl->napi_rx_drops, wl->napi_tx_pauses);
+	}
+	mutex_unlock(&wl->napi_mutex);
+}
+
+/* The caller must have stopped all producers: freed the IRQ, or failed
+ * before requesting it. Must not be called with wl->mutex held.
+ */
+static void b43_napi_stop(struct b43_wl *wl)
+{
+	struct sk_buff *skb;
+	bool disabled = false;
+
+	if (!wl->napi_dev)
+		return;
+
+	/* b43_wireless_core_stop() drops wl->mutex, so a stop and a
+	 * controller restart can both get here for one napi_enable().
+	 */
+	mutex_lock(&wl->napi_mutex);
+	if (!wl->napi_enabled)
+		goto out_unlock;
+	napi_disable(&wl->napi);
+	/* napi_disable() returns once the poll function has given up NAPI,
+	 * which may be before its recheck after napi_complete_done().
+	 */
+	synchronize_net();
+	wl->napi_enabled = false;
+	while ((skb = skb_dequeue(&wl->napi_queue))) {
+		bool tx = skb->pkt_type == B43_NAPI_TX;
+
+		skb->pkt_type = 0;
+		if (tx)
+			ieee80211_free_txskb(wl->hw, skb);
+		else
+			dev_kfree_skb_any(skb);
+	}
+	atomic_set(&wl->napi_tx_queued, 0);
+	disabled = true;
+out_unlock:
+	mutex_unlock(&wl->napi_mutex);
+
+	/* Lift a TX pause of this NAPI instance. If b43_napi_start() has
+	 * enabled NAPI again in the meantime, the pause belongs to that one.
+	 * Wake the queues only if no ring or software stop is pending and
+	 * the core is not started; b43_wireless_core_start() wakes them
+	 * when it starts.
+	 */
+	mutex_lock(&wl->mutex);
+	if (!wl->napi_enabled && wl->napi_tx_blocked) {
+		struct b43_wldev *dev = wl->current_dev;
+
+		WRITE_ONCE(wl->napi_tx_blocked, false);
+		if (dev && b43_status(dev) < B43_STAT_STARTED &&
+		    wl->shared_tx_queue && !b43_using_pio_transfers(dev) &&
+		    !wl->tx_queue_stopped[IEEE80211_AC_BE] &&
+		    dev->dma.tx_ring_AC_BE &&
+		    !dev->dma.tx_ring_AC_BE->stopped &&
+		    dev->dma.tx_ring_mcast &&
+		    !dev->dma.tx_ring_mcast->stopped)
+			ieee80211_wake_queues(wl->hw);
+	}
+	if (disabled)
+		b43dbg(wl, "NAPI disabled (%llu RX drops, %llu TX pauses so far)\n",
+		       wl->napi_rx_drops, wl->napi_tx_pauses);
+	mutex_unlock(&wl->mutex);
+}
