+/* How many more frames the ring for this skb's queue takes */
+int b43_dma_tx_free_frames(struct b43_wldev *dev, struct sk_buff *skb)
+{
+	struct b43_dmaring *ring =
+		select_ring_by_priority(dev, skb_get_queue_mapping(skb));
+
+	if (ring->stopped)
+		return 0;
+	return free_slots(ring) / TX_SLOTS_PER_FRAME;
+}
+
+/* Frames for an A-MPDU wait in the software queue while the ring already
+ * has enough aggregates queued: otherwise each one goes out on its own.
+ */
+#define B43_AMPDU_INFLIGHT	2
+
+bool b43_dma_ampdu_busy(struct b43_wldev *dev, struct sk_buff *skb)
+{
+	return select_ring_by_priority(dev, skb_get_queue_mapping(skb))->
+		ampdu_inflight >= B43_AMPDU_INFLIGHT;
+}
+
+/* Queue the MPDUs of one A-MPDU (all to the same TID and peer, at the same
+ * rate) back to back, and start DMA once. Takes all skbs from @list
+ * unless it fails before queueing the first one.
+ */
+int b43_dma_tx_ampdu(struct b43_wldev *dev, struct sk_buff_head *list,
+		     const u8 *ndelim, unsigned int total)
+{
+	struct sk_buff *skb = skb_peek(list);
+	unsigned int n = skb_queue_len(list), i;
+	unsigned int queue = skb_get_queue_mapping(skb);
+	struct b43_dmaring *ring = select_ring_by_priority(dev, queue);
+	struct b43_ampdu_txinfo ampdu = { .total = total };
+	int err = 0;
+
+	if (ring->stopped || free_slots(ring) < n * TX_SLOTS_PER_FRAME)
+		return -ENOSPC;
+	ring->queue_prio = queue;
+
+	for (i = 0; i < n; i++) {
+		skb = __skb_dequeue(list);
+		ampdu.first = i == 0;
+		ampdu.pos = i == n - 1 ? B43_AMPDU_LAST :
+			    i == 0 ? B43_AMPDU_FIRST : B43_AMPDU_INTER;
+		ampdu.ndelim = ndelim[i];
+		err = dma_tx_fragment(ring, skb, &ampdu, i == n - 1);
+		if (unlikely(err)) {
+			if (i == 0) {
+				__skb_queue_head(list, skb);
+				return err;
+			}
+			/* Can't take back what is queued: send it as is */
+			b43err(dev->wl, "A-MPDU: TX mapping failure\n");
+			ieee80211_free_txskb(dev->wl->hw, skb);
+			while ((skb = __skb_dequeue(list)))
+				ieee80211_free_txskb(dev->wl->hw, skb);
+			wmb();
+			ring->ops->poke_tx(ring, next_slot(ring, ring->current_slot));
+			break;
+		}
+	}
+
+	ring->ampdu_inflight++;
+	if (free_slots(ring) < TX_SLOTS_PER_FRAME) {
+		b43_stop_queue(dev, queue);
+		dev->wl->tx_queue_stopped[queue] = true;
+		ring->stopped = true;
+	}
+	return 0;
+}
+
+/* Report one MPDU of an A-MPDU to mac80211, which takes the status of
+ * each as one attempt of an aggregate.
+ */
+static void dma_ampdu_report(struct b43_wldev *dev, struct sk_buff *skb,
+			     bool acked)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	u8 tries = info->control.rates[3].count + 1;
+
+	ieee80211_tx_info_clear_status(info);
+	info->status.rates[0].count = tries;
+	info->status.rates[1].idx = -1;
+	info->flags |= IEEE80211_TX_STAT_AMPDU;
+	info->status.ampdu_len = 1;
+	info->status.ampdu_ack_len = acked;
+	if (acked)
+		info->flags |= IEEE80211_TX_STAT_ACK;
+	/* No IEEE80211_TX_STAT_AMPDU_NO_BACK: mac80211 would send one BAR per
+	 * MPDU given up, see dma_ampdu_send_bar()
+	 */
+	ieee80211_tx_status_skb(dev->wl->hw, skb);
+}
+
+/* Each MPDU gets this many more tries in later A-MPDUs (the ucode sends an
+ * A-MPDU once; brcmsmac retries in the driver too, up to 5). With 2, on a
+ * busy 2.4 GHz channel ~3% of the MPDUs were given up, which TCP feels.
+ */
+#define B43_AMPDU_RETRIES	4
+
+/* seq a is before b, modulo 4096 */
+static bool b43_seq_before(u16 a, u16 b)
+{
+	return a != b && ((b - a) & 0xFFF) < 0x800;
+}
+
+/* MPDUs up to @gaveup were given up: move the recipient's window past them
+ * with one BAR. mac80211 sends a BAR for every MPDU flagged NO_BACK; after
+ * a bad A-MPDU those queue up behind each other, each takes a channel
+ * access, and the BAR/BA ping-pong starved the data (measured: 2500 BARs
+ * in 3 s). The window may only move as far as the oldest MPDU still to be
+ * retried or in flight, or the recipient drops it as old.
+ */
+static void dma_ampdu_send_bar(struct b43_wldev *dev, struct ieee80211_vif *vif,
+			       u8 *ra, u8 tid, u16 gaveup,
+			       struct sk_buff_head *retry)
+{
+	struct b43_wl *wl = dev->wl;
+	u16 ssn = (gaveup + 1) & 0xFFF;
+	struct sk_buff *skb;
+	int i;
+
+	skb_queue_walk(retry, skb) {
+		struct ieee80211_hdr *h = (struct ieee80211_hdr *)skb->data;
+		u16 s = le16_to_cpu(h->seq_ctrl) >> 4;
+
+		if (ieee80211_get_tid(h) == tid && b43_seq_before(s, ssn))
+			ssn = s;
+	}
+	for (i = 0; i < wl->ampdu_nssn[tid]; i++)
+		if (b43_seq_before(wl->ampdu_ssn[tid][i], ssn))
+			ssn = wl->ampdu_ssn[tid][i];
+	if ((wl->ampdu_bar_ssn[tid] & 0x8000) &&
+	    !b43_seq_before(wl->ampdu_bar_ssn[tid] & 0xFFF, ssn))
+		return;
+	wl->ampdu_bar_ssn[tid] = ssn | 0x8000;
+	ieee80211_send_bar(vif, ra, tid, ssn << 4);
+}
+
+static void dma_handle_ampdu_txstatus(struct b43_wldev *dev,
+				      struct b43_dmaring *ring, int slot,
+				      const struct b43_txstatus *status)
+{
+	const struct b43_dma_ops *ops = ring->ops;
+	struct b43_dmadesc_meta *meta;
+	struct sk_buff_head retry;
+	struct sk_buff_head *q;
+	unsigned long flags;
+	bool first = true;
+	struct ieee80211_vif *vif = NULL;
+	u8 ra[ETH_ALEN], tid = 0;
+	int gaveup = -1;
+
+	__skb_queue_head_init(&retry);
+	if (ring->ampdu_inflight > 0)
+		ring->ampdu_inflight--;
+	while (1) {
+		struct ieee80211_tx_info *info;
+		struct ieee80211_hdr *hdr;
+		struct sk_buff *skb;
+		bool acked = false;
+		u8 pos;
+
+		/* Header */
+		ops->idx2desc(ring, slot, &meta);
+		if (unlikely(meta->skb)) {
+			b43dbg(dev->wl, "A-MPDU status: unexpected skb at slot %d on ring %d\n",
+			       slot, ring->index);
+			break;
+		}
+		unmap_descbuffer(ring, meta->dmaaddr, b43_txhdr_size(dev), 1);
+		ring->used_slots--;
+
+		/* Payload */
+		slot = next_slot(ring, slot);
+		ops->idx2desc(ring, slot, &meta);
+		skb = meta->skb;
+		if (unlikely(!skb || b43_dma_ptr_is_poisoned(skb))) {
+			b43dbg(dev->wl, "A-MPDU status: no skb at slot %d on ring %d\n",
+			       slot, ring->index);
+			break;
+		}
+		info = IEEE80211_SKB_CB(skb);
+		unmap_descbuffer(ring, meta->dmaaddr, skb->len, 1);
+		kfree(b43_get_priv_tx_info(info)->bouncebuffer);
+		b43_get_priv_tx_info(info)->bouncebuffer = NULL;
+		info->control.vif = meta->vif;
+		pos = meta->ampdu;
+		meta->skb = B43_DMA_PTR_POISON;
+		ring->used_slots--;
+
+		hdr = (struct ieee80211_hdr *)skb->data;
+		if (first) {
+			struct b43_wl *wl = dev->wl;
+			u8 tid = ieee80211_get_tid(hdr);
+			u16 seq = le16_to_cpu(hdr->seq_ctrl) >> 4;
+			int i;
+
+			for (i = 0; i < wl->ampdu_nssn[tid]; i++) {
+				if (wl->ampdu_ssn[tid][i] != seq)
+					continue;
+				wl->ampdu_ssn[tid][i] =
+					wl->ampdu_ssn[tid][--wl->ampdu_nssn[tid]];
+				break;
+			}
+			first = false;
+		}
+		if (status->ba) {
+			u16 idx = ((le16_to_cpu(hdr->seq_ctrl) >> 4) -
+				   status->ba_start) & 0xFFF;
+
+			acked = idx < 64 &&
+				(status->ba_bitmap[idx / 8] & BIT(idx % 8));
+		}
+		if (!acked && info->control.rates[3].count < B43_AMPDU_RETRIES) {
+			info->control.rates[3].count++;
+			__skb_queue_tail(&retry, skb);
+		} else {
+			if (!acked && ieee80211_is_data_qos(hdr->frame_control)) {
+				gaveup = le16_to_cpu(hdr->seq_ctrl) >> 4;
+				tid = ieee80211_get_tid(hdr);
+				ether_addr_copy(ra, hdr->addr1);
+				vif = info->control.vif;
+			}
+			dma_ampdu_report(dev, skb, acked);
+		}
+
+		if (pos != B43_AMPDU_FIRST && pos != B43_AMPDU_INTER)
+			break;
+		slot = next_slot(ring, slot);
+	}
+
+	if (gaveup >= 0 && vif)
+		dma_ampdu_send_bar(dev, vif, ra, tid, gaveup, &retry);
+
+	/* Retransmit before anything newer of this queue */
+	q = &dev->wl->tx_queue[ring->queue_prio];
+	spin_lock_irqsave(&q->lock, flags);
+	skb_queue_splice(&retry, q);
+	spin_unlock_irqrestore(&q->lock, flags);
+}
+
 void b43_dma_handle_txstatus(struct b43_wldev *dev,
 			     const struct b43_txstatus *status)
 {
@@ -1467,6 +1726,11 @@ void b43_dma_handle_txstatus(struct b43_wldev *dev,
 	}
 
 	ops = ring->ops;
+	if (status->for_ampdu) {
+		if (likely(!skip))
+			dma_handle_ampdu_txstatus(dev, ring, slot, status);
+		goto out_wake;
+	}
 	while (1) {
 		B43_WARN_ON(slot < 0 || slot >= ring->nr_slots);
 		/* get meta - ignore returned value */
@@ -1557,6 +1821,7 @@ void b43_dma_handle_txstatus(struct b43_wldev *dev,
 		if (skip > 0)
 			--skip;
 	}
+out_wake:
 	if (ring->stopped) {
 		B43_WARN_ON(free_slots(ring) < TX_SLOTS_PER_FRAME);
 		ring->stopped = false;
