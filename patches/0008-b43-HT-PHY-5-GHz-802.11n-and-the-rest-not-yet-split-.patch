+		/* Up to 124 null delimiters work; from 127 on the PHY aborts
+		 * the A-MPDU (txphyerr counts every one)
+		 */
+		nd = min_t(unsigned int, len < min_bytes ?
+			   DIV_ROUND_UP(min_bytes - len, 4) : 0, 120);
+		add = round_up(len, 4) + 4 * (nd + 1);
