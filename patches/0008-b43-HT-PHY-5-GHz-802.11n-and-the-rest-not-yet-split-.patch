+/* 802.11n (HT) rates: 20 or 40 MHz, mixed-mode preamble.
+ * Upper byte of PHY control word 1 per MCS (coding rate bits 0-2,
+ * modulation bits 3-5, streams - 1 in bits 6-7), and data bits per OFDM
+ * symbol for one stream; as in brcmsmac's mcs_table, except coding rate
+ * 2/3 (MCS 5, 13, 21; and 48 Mbit/s OFDM): its code 1 (bit 8 of the
+ * control word) makes the HT-PHY send something nobody decodes, no
+ * error reported. The PHY takes the coding rate from the PLCP anyway:
+ * any even code sends correct frames, so 2/3 gets 0.
+ */
+static const u8 b43_ht_phy_ctl3[8] = {
+	0x00, 0x08, 0x0A, 0x10, 0x12, 0x18, 0x1A, 0x1C,
+};
+static const u16 b43_ht_ndbps[8] = { 26, 52, 78, 104, 156, 208, 234, 260 };
+
+/* 40 MHz: data bits per symbol are 54/26 of the 20 MHz ones */
+static unsigned int b43_ht_ndbps_bw(u8 mcs, bool ht40)
+{
+	unsigned int n = b43_ht_ndbps[mcs & 7];
+
+	return ht40 ? n * 54 / 26 : n;
+}
+
+static u16 b43_ht_tx_phy_ctl1(struct b43_wldev *dev, u8 mcs, bool ht40)
+{
+	u16 control;
+
+	if (ht40)
+		control = B43_TXH_PHY1_BW_40;
+	else if (dev->phy.bw40 && dev->phy.ctl_upper)
+		control = B43_TXH_PHY1_BW_20U;
+	else
+		control = B43_TXH_PHY1_BW_20;
+
+	/* One stream goes out of all chains with cyclic delay diversity */
+	control |= mcs < 8 ? B43_TXH_PHY1_MODE_CDD : B43_TXH_PHY1_MODE_SDM;
+	control |= (b43_ht_phy_ctl3[mcs & 7] | ((mcs >> 3) << 6)) << 8;
+	return control;
+}
+
+static void b43_generate_ht_plcp(struct b43_plcp_hdr6 *plcp,
+				 unsigned int len, u8 mcs, bool sgi, bool ht40)
+{
+	/* HT-SIG: MCS, 40 MHz; length; smoothing + not sounding + reserved,
+	 * short GI
+	 */
+	memset(plcp, 0, sizeof(*plcp));
+	plcp->raw[0] = mcs | (ht40 ? 0x80 : 0);
+	plcp->raw[1] = len & 0xFF;
+	plcp->raw[2] = len >> 8;
+	plcp->raw[3] = 0x07 | (sgi ? 0x80 : 0);
+}
+
+/* L-SIG length the hardware puts in front of a mixed-mode frame, so legacy
+ * stations defer for the whole HT frame: (TXTIME - 20 us) in 4 us symbols
+ * of 3 bytes, minus SERVICE and tail (IEEE 802.11-2012 20.3.9.4.3).
+ */
+static u16 b43_ht_lsig_len(u8 mcs, unsigned int len, bool sgi, bool ht40)
+{
+	unsigned int nss = (mcs >> 3) + 1;
+	unsigned int nsyms;
+
+	nsyms = DIV_ROUND_UP(16 + 8 * len + 6, b43_ht_ndbps_bw(mcs, ht40) * nss);
+	if (sgi)	/* 3.6 us symbols */
+		nsyms = DIV_ROUND_UP(nsyms * 9, 10);
+	/* HT-SIG (2), HT-STF (1) and the HT-LTFs */
+	nsyms += 3 + (nss == 3 ? 4 : nss);
+	return 3 * nsyms - 3;
+}
+
+unsigned int b43_ht_rate_kbps(u8 mcs, bool sgi, bool ht40)
+{
+	unsigned int bits = b43_ht_ndbps_bw(mcs, ht40) * ((mcs >> 3) + 1);
+
+	return sgi ? bits * 10000 / 36 : bits * 1000 / 4;
+}
+
+/* Length of the MPDU on the air: with FCS and the ICV/MIC the hardware
+ * appends
+ */
+unsigned int b43_tx_mpdu_len(struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+
+	return skb->len + FCS_LEN +
+	       (info->control.hw_key ? info->control.hw_key->icv_len : 0);
+}
+
+/* Turn a generated TX header into one MPDU of an A-MPDU (brcmsmac's
+ * ampdu_add_frame/ampdu_finalize): the first one carries the PPDU, so its
+ * PLCP gets the whole A-MPDU length and the aggregation bit. No RTS/CTS:
+ * its NAV would only cover the first MPDU.
+ */
+void b43_txhdr_ampdu(u8 *_txhdr, enum b43_ampdu_pos pos, bool first,
+		     unsigned int total, u8 ndelim)
+{
+	struct b43_txhdr *txhdr = (struct b43_txhdr *)_txhdr;
+	u32 mac_ctl = le32_to_cpu(txhdr->mac_ctl);
+	struct b43_plcp_hdr6 *plcp = &txhdr->format_598.plcp;
+
+	mac_ctl &= ~(B43_TXH_MAC_AMPDU | B43_TXH_MAC_SENDRTS |
+		     B43_TXH_MAC_SENDCTS | B43_TXH_MAC_STMSDU);
+	mac_ctl |= pos << 9;
+	if (first)
+		mac_ctl |= B43_TXH_MAC_STMSDU;
+	txhdr->mac_ctl = cpu_to_le32(mac_ctl);
+	/* Null delimiters after this MPDU, for the recipient's MPDU
+	 * start spacing
+	 */
+	txhdr->rts_plcp_fb.raw[5] = ndelim;
+
+	if (first) {
+		u8 mcs = plcp->raw[0] & 0x7F;
+		bool ht40 = plcp->raw[0] & 0x80;
+		bool sgi = plcp->raw[3] & 0x80;
+
+		plcp->raw[1] = total & 0xFF;
+		plcp->raw[2] = total >> 8;
+		plcp->raw[3] |= 0x08;
+		txhdr->mimo_modelen =
+			cpu_to_le16(b43_ht_lsig_len(mcs, total, sgi, ht40));
+	}
+}
+
+/* NAV for a unicast HT frame: SIFS + the legacy ACK, sent at the highest
+ * mandatory rate not above the MCS's legacy equivalent. mac80211 leaves it
+ * to the hardware for MCS rates.
+ */
+static __le16 b43_ht_duration(u8 mcs)
+{
+	static const u8 ack_ndbps[8] = { 24, 48, 48, 96, 96, 96, 96, 96 };
+
+	return cpu_to_le16(16 + 20 + 4 *
+			   DIV_ROUND_UP(16 + 14 * 8 + 6, ack_ndbps[mcs & 7]));
+}
