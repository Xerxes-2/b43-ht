+/* Per channel and bandwidth settings, as the proprietary driver leaves
+ * them (it adapts the CRS thresholds to interference later; we don't).
+ */
+static void b43_phy_ht_bw_setup(struct b43_wldev *dev,
+				struct ieee80211_channel *channel, u16 freq)
+{
+	struct b43_phy *phy = &dev->phy;
+	bool g = channel->band == NL80211_BAND_2GHZ;
+	const s16 *txf;
+	u16 v;
+	int c, i;
+
+	/* Which half is primary (N-PHY rev 7 BPHY_BAND_SEL_UP20 and
+	 * PRIM_SEL_UP20, the same here). Cleared at 20 MHz too: bit 4 of
+	 * 0x0a0 comes out of reset set.
+	 */
+	b43_phy_maskset(dev, 0x0a0, ~0x0010, phy->ctl_upper ? 0x0010 : 0);
+	b43_phy_maskset(dev, 0x310, 0x7fff, phy->ctl_upper ? 0x8000 : 0);
+
+	/* CRS minimum power, it seems (the proprietary driver raises it
+	 * under interference). Replaces upstream's fixed 0x3e/0x40.
+	 */
+	if (phy->bw40)
+		v = 0x3c;
+	else if (!g && freq >= 5765)
+		v = 0x41;
+	else
+		v = 0x3f;
+	b43_phy_maskset(dev, 0x0280, 0xff00, v);
+	b43_phy_maskset(dev, 0x0283, 0xff00, v);
+
+	/* Also adapted to interference by the proprietary driver */
+	v = 0x140 | (g ? 0xd : phy->bw40 ? 0x18 : 0x19);
+	for (c = 0; c < 3; c++)
+		b43_phy_write(dev, B43_PHY_OFDM(0x24 + c * 0x40), v);
+
+	for (c = 0; c < 3; c++) {
+		b43_httab_write(dev, B43_HTTAB16(7, 0x14a + c * 0x10),
+				phy->bw40 ? 4 : 2);
+		b43_httab_write(dev, B43_HTTAB16(8, 0x04 + c * 0x10),
+				phy->bw40 ? 0xfc60 : 0xa840);
+		b43_httab_write(dev, B43_HTTAB16(8, 0x05 + c * 0x10),
+				phy->bw40 ? 0xc : 0x8);
+	}
+	b43_phy_write(dev, 0x02f2, 0x1c1c);
+	b43_phy_write(dev, 0x02f3, 0x001c);
+
+	txf = g && (channel->hw_value == 1 || channel->hw_value == 13) ?
+	      b43_phy_ht_txf20_edge : b43_phy_ht_txf20_default;
+	for (i = 0; i < 15; i++)
+		b43_phy_write(dev, 0x186 + i, txf[i]);
+}
