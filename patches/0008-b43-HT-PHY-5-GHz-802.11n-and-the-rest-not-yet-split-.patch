+	kbps = b43_ht_rate_kbps(rate->idx,
+				rate->flags & IEEE80211_TX_RC_SHORT_GI,
+				dev->phy.bw40 &&
+				rate->flags & IEEE80211_TX_RC_40_MHZ_WIDTH);
+	/* 3 ms on the air (brcmsmac: 5 ms). Measured at MCS 15 up to 5 ms
+	 * without losses at the tail; on a busy 2.4 GHz channel TCP did a
+	 * bit worse at 5 ms than at 3.
+	 */
+	max_len = min(wl->ampdu_max_len, kbps * 3 / 8);
+	/* MPDU start spacing: the recipient's, but at least 16 us. DMA
+	 * fetches every MPDU separately and can't keep up with a run of tiny
+	 * ones (TCP ACKs) at high MCS: the TX FIFO underflows and the PHY
+	 * aborts. Null delimiters give it time: at 40 MHz MCS 15, 10 us left
+	 * ~75 underflows a second, 16 us none. (Setting the TX header's
+	 * preload size instead stalls the ucode with this firmware.)
+	 */
+	min_bytes = max(spacing_qus[wl->ampdu_density & 7] * kbps / 32000,
+			kbps * 16 / 8000);
+	max_frames = min_t(unsigned int, wl->ampdu_buf[tid] ? : 1,
+			   ARRAY_SIZE(ndelim));
+	max_frames = min_t(unsigned int, max_frames,
