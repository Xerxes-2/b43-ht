+/* Build an A-MPDU from @skb and the following frames of the queue for the
+ * same TID, and hand it to DMA. Limits: the recipient's window and max
+ * length, and 3 ms on the air. On -ENOSPC everything is back in the queue.
+ */
+static int b43_tx_ampdu(struct b43_wldev *dev, int queue_num,
+			struct sk_buff *skb)
+{
+	static const u8 spacing_qus[8] = { 0, 1, 2, 4, 8, 16, 32, 64 };
+	struct b43_wl *wl = dev->wl;
+	struct sk_buff_head *q = &wl->tx_queue[queue_num];
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+	struct ieee80211_tx_rate *rate = &info->control.rates[0];
+	u8 tid = ieee80211_get_tid(hdr);
+	unsigned int kbps, max_len, max_frames, min_bytes, total = 0, len = 0;
+	struct sk_buff_head agg;
+	u8 ndelim[64];
+	unsigned int n = 0, i;
+	u16 ssn;
+	int err;
+
+	if (wl->ampdu_nssn[tid] >= ARRAY_SIZE(wl->ampdu_ssn[0])) {
+		skb_queue_head(q, skb);
+		return -EBUSY;
+	}
+	/* The recipient's window starts at the oldest MPDU not yet acked:
+	 * ours (retries come first) or one in flight. Anything 64 or more
+	 * past it makes the recipient move its window and drop the old ones.
+	 */
+	ssn = le16_to_cpu(hdr->seq_ctrl) >> 4;
+	for (i = 0; i < wl->ampdu_nssn[tid]; i++)
+		if (((ssn - wl->ampdu_ssn[tid][i]) & 0xFFF) < 0x800)
+			ssn = wl->ampdu_ssn[tid][i];
